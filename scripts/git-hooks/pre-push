#!/usr/bin/env sh
# pre-push: mirror every push to GitHub (origin) into the platform Gitea repo.
# Part of option (b): GitHub stays the working repo, Gitea is the ArgoCD source.
#
# Skips when:
#   - the target remote is Gitea itself (no recursion);
#   - MLSCAN_SKIP_MIRROR=1 is set (escape hatch).
#
# Resilience: by default a mirror failure only warns and lets the GitHub push
# proceed (Gitea outages must not block development). Set MLSCAN_REQUIRE_MIRROR=1
# to make mirror failures fatal.
#
# Git passes: $1 = remote name, $2 = remote URL.
set -u

remote_url="${2:-}"

case "$remote_url" in
  *git.platform.rtx.local*) exit 0 ;;
esac
[ "${MLSCAN_SKIP_MIRROR:-0}" = "1" ] && exit 0

repo_root="$(git rev-parse --show-toplevel)"
[ -x "$repo_root/scripts/mirror-gitea.sh" ] || exit 0

if "$repo_root/scripts/mirror-gitea.sh"; then
  exit 0
fi

echo "[mirror-gitea] WARNING: Gitea mirror failed; GitHub push continues." >&2
echo "[mirror-gitea] run scripts/mirror-gitea.sh to sync the ArgoCD source later." >&2
if [ "${MLSCAN_REQUIRE_MIRROR:-0}" = "1" ]; then
  exit 1
fi
exit 0
